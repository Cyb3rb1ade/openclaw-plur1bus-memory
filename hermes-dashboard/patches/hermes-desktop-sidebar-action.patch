@@ -0,0 +1,15 @@
+import { describe, expect, it, vi } from 'vitest'
+import { contributedNavigation } from './contributed-navigation'
+
+describe('contributed navigation intent', () => {
+  it('opens action-only workspaces without changing the route, while preserving route contributions', () => {
+    const open = vi.fn()
+    const action = contributedNavigation({ label: 'Memory', onSelect: open, path: '/unused' })
+    action?.onSelect?.()
+    expect(open).toHaveBeenCalledOnce()
+    expect(action).not.toHaveProperty('route')
+    expect(contributedNavigation({ label: 'Board', path: '/board' })).toEqual({ route: '/board' })
+    expect(contributedNavigation({ label: 'Invalid' })).toBeNull()
+    expect(contributedNavigation({ path: '/missing-label' })).toBeNull()
+  })
+})
