--- /dev/null
+++ b/apps/desktop/src/app/chat/sidebar/contributed-navigation.ts
@@ -0,0 +1,8 @@
+import type { SidebarNavContribution } from '@/app/routes'
+
+/** Resolve one navigation intent: a workspace action takes precedence over a route. */
+export function contributedNavigation(data: Partial<SidebarNavContribution> | undefined) {
+  if (!data?.label) return null
+  if (typeof data.onSelect === 'function') return { onSelect: data.onSelect }
+  return data.path?.startsWith('/') ? { route: data.path } : null
+}
