+++ b/apps/desktop/electron/backend-connection-state.test.ts
@@ -3,9 +3,28 @@ import assert from 'node:assert/strict'
 import { test } from 'vitest'
 
 import { createBackendConnectionState } from './backend-connection-state'
+import { resolveProfileBackendRoute } from './connection-config'
 
 type FakeProcess = { id: string }
 
+test('remembering another profile never relabels the live primary backend', () => {
+  const state = createBackendConnectionState<FakeProcess, string>()
+  let remembered = 'alpha'
+  const attempt = state.startAttempt(remembered)
+  state.setPromise(attempt, Promise.resolve('alpha-backend'))
+  const owner = state.attachProcess(attempt, { id: 'alpha' })!
+  remembered = 'beta'
+  const primary = state.getProfile() || remembered
+  assert.equal(primary, 'alpha')
+  assert.equal(resolveProfileBackendRoute('beta', { primaryProfile: primary }).backend, 'pool')
+  assert.equal(resolveProfileBackendRoute('alpha', { primaryProfile: primary }).backend, 'primary')
+  state.invalidate()
+  state.startAttempt(remembered)
+  assert.equal(state.getProfile(), 'beta')
+  assert.equal(state.clearForCurrentProcess(owner), false)
+  assert.equal(state.getProfile(), 'beta')
+})
+
 function deferred<T>() {
