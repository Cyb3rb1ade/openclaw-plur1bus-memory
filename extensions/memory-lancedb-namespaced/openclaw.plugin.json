{
  "id": "memory-lancedb-namespaced",
  "name": "Memory (LanceDB, per-Agent)",
  "description": "LanceDB-backed long-term memory with per-agent isolation. Each agent gets its own database under {baseDbPath}/{agentId}/.",
  "version": "1.0.0",
  "kind": "memory",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "embedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": { "type": "string" },
          "model": { "type": "string" },
          "baseUrl": { "type": "string" },
          "dimensions": { "type": "number" }
        },
        "required": ["apiKey"]
      },
      "baseDbPath": { "type": "string" },
      "autoCapture": { "type": "boolean" },
      "autoRecall": { "type": "boolean" },
      "captureMaxChars": { "type": "number" },
      "recallMinScore":     { "type": "number", "default": 0.15 },
      "autoRecallMinScore": { "type": "number", "default": 0.2 },
      "duplicateThreshold": { "type": "number", "default": 0.95 },
      "forgetThreshold":    { "type": "number", "default": 0.3 },
      "summaryMaxWords":    { "type": "number", "default": 75 },
      "reranker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled":    { "type": "boolean" },
          "apiKey":     { "type": "string" },
          "model":      { "type": "string" },
          "candidates": { "type": "number" }
        },
        "required": ["apiKey"]
      },
      "merging": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled":        { "type": "boolean", "default": false },
          "threshold":      { "type": "number",  "default": 0.70 },
          "model":          { "type": "string" },
          "baseUrl":        { "type": "string" },
          "apiKey":         { "type": "string" },
          "disableThinking":{ "type": "boolean" },
          "headers":        { "type": "object" }
        }
      },
      "schicht15": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled":        { "type": "boolean", "default": false },
          "model":          { "type": "string" },
          "baseUrl":        { "type": "string" },
          "apiKey":         { "type": "string" },
          "disableThinking":{ "type": "boolean" },
          "headers":        { "type": "object" },
          "minImportance":  { "type": "number", "default": 0.7 }
        }
      },
      "gc": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true }
        }
      }
    },
  }
}
