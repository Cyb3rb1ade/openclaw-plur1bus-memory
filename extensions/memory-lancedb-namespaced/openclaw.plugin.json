    "memoryEmbeddingProviders": [
      "plur1bus-openai",
      "plur1bus-openai-compatible",
      "plur1bus-e5-small"
    ],
    "tools": [
      "knowledge_update",
      "memory_forget",
      "memory_recall",
      "memory_search",
      "memory_store"
    ]
  },
