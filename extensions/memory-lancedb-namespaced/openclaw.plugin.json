{
  "id": "memory-lancedb-namespaced",
  "name": "Memory (LanceDB, per-Agent)",
  "description": "PLUR1BUS neo-arch cognitive memory augment with per-agent LanceDB memory and OpenClaw-native turn journal, provenance, curation, and recall.",
  "version": "3.0.0-neo.0",
  "contracts": {
    "tools": [
      "knowledge_update",
      "memory_forget",
      "memory_recall",
      "memory_store"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "embedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "dimensions": {
            "type": "number"
          },
          "fallback": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "apiKey": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "apiKey"
        ]
      },
      "baseDbPath": {
        "type": "string"
      },
      "neo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "augment",
              "slot"
            ],
            "default": "augment"
          },
          "statePath": {
            "type": "string"
          },
          "corpusDefaultWorkspaceKey": {
            "type": "string"
          }
        }
      },
      "autoCapture": {
        "type": "boolean"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "captureMaxChars": {
        "type": "number"
      },
      "recallMinScore": {
        "type": "number",
        "default": 0.15
      },
      "autoRecallMinScore": {
        "type": "number",
        "default": 0.2
      },
      "duplicateThreshold": {
        "type": "number",
        "default": 0.95
      },
      "forgetThreshold": {
        "type": "number",
        "default": 0.3
      },
      "summaryMaxWords": {
        "type": "number",
        "default": 75
      },
      "reranker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "apiKey": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "candidates": {
            "type": "number"
          }
        },
        "required": [
          "apiKey"
        ]
      },
      "merging": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "threshold": {
            "type": "number",
            "default": 0.70
          },
          "model": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "disableThinking": {
            "type": "boolean"
          },
          "headers": {
            "type": "object"
          }
        }
      },
      "schicht15": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "model": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "disableThinking": {
            "type": "boolean"
          },
          "headers": {
            "type": "object"
          },
          "minImportance": {
            "type": "number",
            "default": 0.7
          }
        }
      },
      "gc": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "recall": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "importanceBoost": {
            "type": "number",
            "default": 0.3
          },
          "dedup": {
            "type": "boolean",
            "default": true
          },
          "dedupJaccard": {
            "type": "number",
            "default": 0.6
          },
          "canonicalFirst": {
            "type": "boolean",
            "default": true
          },
          "canonicalMinScore": {
            "type": "number",
            "default": 0.30
          },
          "canonicalMaxItems": {
            "type": "number",
            "default": 2
          }
        }
      }
    }
  }
}
